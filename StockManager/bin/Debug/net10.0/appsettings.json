{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=stockmanager;Username=postgres;Password=7452"
  },

  "Database": {
    "ApplyMigrationsOnStartup": true
  },

  "Jwt": {
    "Key": "DEV-ONLY-change-me-use-user-secrets-or-env-var-min-32-chars",
    "Issuer": "StockManager",
    "Audience": "StockManager.Clients",
    "ExpiryMinutes": 60
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },

  "RateLimiting": {
    "PermitLimit": 100,
    "AuthPermitLimit": 10,
    "WindowSeconds": 60
  },

  "FileStorage": {
    "MaxFileSizeBytes": 2097152,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "UploadsFolder": "uploads/products"
  },

  "Currency": {
    "BaseUrl": "https://open.er-api.com/",
    "BaseCurrency": "USD",
    "CacheMinutes": 60,
    "TimeoutSeconds": 5,
    "RetryCount": 3
  },

  "Seed": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": "System Administrator"
  },

  "Swagger": {
    "Enabled": false
  }
}
